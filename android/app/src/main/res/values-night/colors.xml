<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Açılış zemini — dark mode. Light karşılığı values/colors.xml içindedir.
         Değer SandikPalette.dark `background` (#0A1E15) ile aynı olmalı;
         ayrışırsa native splash ile Flutter splash arasında renk sıçraması
         görünür. -->
    <color name="sandik_background">#0A1E15</color>

    <!-- Ana ekran widget'ı — dark mode. Değerler SandikPalette.dark ile
         hizalı: surface1/text90/text36/gain. -->
    <color name="widget_bg">#112E28</color>
    <color name="widget_text_primary">#FFFFFF</color>
    <color name="widget_text_muted">#8FA39B</color>
    <color name="widget_gain">#3DB77F</color>
    <color name="widget_loss">#FF6B52</color>
    <color name="widget_pill_bg">#14FFFFFF</color>
    <!-- Marka altını — SandikTheme.gold ile birebir aynı. -->
    <color name="widget_gold">#F5C842</color>
    <!-- Hairline ayraç — SandikTheme.hairline (beyaz @ %10). -->
    <color name="widget_hairline">#1AFFFFFF</color>
    <!-- Logo tonu — marka amber'i (SandikTheme.amber). Her iki modda aynı;
         amber marka işaretinin rengidir, moda göre değişmez. -->
    <color name="widget_logo_tint">#F5A623</color>
</resources>
