<!--
  Sandık logo işareti — `ios/SandikWidget/SandikLogoMark.swift` ile aynı
  geometri (viewBox 64×64; "E · İkon-sandık", 2026-10-01).

  Uygulama ikonunun dalga katmanları, üstte kapak aralığı (y 23…26) ve
  ortada kilit levhası. Önceki çizgi kasa işareti ikonla bağ kurmuyordu ve
  küçükte ışık anahtarı gibi okunuyordu; gerekçe Swift dosyasında.

  İki yüzey aynı markayı taşımalı: kilit ekranındaki (Live Activity)
  başlıkta bu işaret var, ana ekran widget'ında da olmalı.

  Renkler path'lere gömülüdür. `android:tint` RemoteViews bağlamında
  güvenilir şekilde uygulanmıyor; işaret marka rengidir, moda göre değişmez.
  iOS'taki dikey gradyan burada düz #F8BE45: vektör gradyanı API 24 ister
  ve 16 dp'de fark görünmez.

  ## Neden elle yazılmış arc yok
  İlk sürüm köşeleri `A` (elliptical arc) komutlarıyla çiziyordu ve
  Android'in vector parser'ında kasa yatık bir dikdörtgene dönüşüyordu.
  Yuvarlak köşeler `M/L` + `Q` (quadratic) ile kuruluyor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <group android:name="kasa">
        <!-- Kapak (üst) + gövde (alt); aradaki bant boş = kapak çizgisi. -->
        <clip-path android:pathData="M20,4 L44,4 Q60,4 60,20 L60,23 L4,23 L4,20 Q4,4 20,4 Z M4,26 L60,26 L60,44 Q60,60 44,60 L20,60 Q4,60 4,44 Z" />

        <path android:fillColor="#F8BE45" android:pathData="M0,0 L64,0 L64,64 L0,64 Z" />
        <path android:fillColor="#E2861F" android:pathData="M-2,28.05 C4,32.1 8,33 13,33 C21,33 24,24 32,24 C40,24 43,33 51,33 C56,33 60,32.1 66,28.05 L66,70 L-2,70 Z" />
        <path android:fillColor="#C56314" android:pathData="M-2,38.05 C4,42.1 8,43 13,43 C21,43 24,34 32,34 C40,34 43,43 51,43 C56,43 60,42.1 66,38.05 L66,70 L-2,70 Z" />
        <path android:fillColor="#993D0A" android:pathData="M-2,48.05 C4,52.1 8,53 13,53 C21,53 24,44 32,44 C40,44 43,53 51,53 C56,53 60,52.1 66,48.05 L66,70 L-2,70 Z" />
    </group>

    <!-- Kilit levhası: (25.5,19) 13×16, r=3.5. -->
    <path
        android:fillColor="#5A2405"
        android:pathData="M29,19 L35,19 Q38.5,19 38.5,22.5 L38.5,31.5 Q38.5,35 35,35 L29,35 Q25.5,35 25.5,31.5 L25.5,22.5 Q25.5,19 29,19 Z" />

    <!-- Anahtar deliği: merkez (32,25.1) r=2.6 + aşağı genişleyen gövde. -->
    <path
        android:fillColor="#FCD35A"
        android:pathData="M32,22.5 Q34.6,22.5 34.6,25.1 Q34.6,27.7 32,27.7 Q29.4,27.7 29.4,25.1 Q29.4,22.5 32,22.5 Z M30.6,26.5 L33.4,26.5 L34.1,31.5 L29.9,31.5 Z" />
</vector>
