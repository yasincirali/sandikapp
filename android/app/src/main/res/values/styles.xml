<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light mode: zemin açık olduğu için taban tema da Light olmalı —
         Theme.Black sistem çubuğu ikonlarını açık zeminde okunmaz bırakıyordu.
         Dark karşılığı values-night/styles.xml içindedir. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Açık zemin → KOYU durum çubuğu ikonu. Theme.Light API 11'den
             kalmadır ve bu bayrağı taşımaz; onsuz ikonlar beyaz kalıyor ve
             açık zeminde okunmuyordu. Flutter ilk frame'i çizince
             SandikLoadingScreen aynı değeri AnnotatedRegion ile sürdürür —
             ikisi eşleşmezse açılışta ikon rengi sıçrar. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
