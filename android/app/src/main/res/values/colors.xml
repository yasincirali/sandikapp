<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Açılış zemini — light mode. Dark karşılığı values-night/colors.xml
         içindedir; ikisi lib/theme/sandik.dart'taki SandikPalette.light /
         .dark `background` token'ları ile aynı olmalı. -->
    <color name="sandik_background">#F4F1EA</color>
	<color name="ic_launcher_background">#0A1E15</color>
    <!-- Bildirim vurgu rengi (marka amber). Android ikonu bu renkle tonlar. -->
    <color name="sandik_notification_accent">#F5A623</color>
    <!-- Ana ekran widget'ı — light mode. Değerler SandikPalette.light ile
         hizalı: background/text90/text36/gain. Dark karşılığı values-night. -->
    <color name="widget_bg">#FBFAF6</color>
    <color name="widget_text_primary">#12241E</color>
    <color name="widget_text_muted">#566761</color>
    <color name="widget_gain">#0F7A4E</color>
    <color name="widget_loss">#C0341F</color>
    <color name="widget_pill_bg">#1412241E</color>
    <!-- Marka altını — kilit ekranında toplam tutar bu renkte yazılır
         (SandikTheme.gold). İki yüzey aynı görünmeli. Light modda gold
         (#F5C842) beyaz zeminde okunmaz; SandikPalette.light'ın amber
         metin karşılığı kullanılır. -->
    <color name="widget_gold">#8A5A00</color>
    <!-- Hairline ayraç — beyaz @ %10'un light karşılığı. -->
    <color name="widget_hairline">#1A12241E</color>
    <!-- Logo tonu — marka amber'i (SandikTheme.amber). Her iki modda aynı;
         amber marka işaretinin rengidir, moda göre değişmez. -->
    <color name="widget_logo_tint">#F5A623</color>
</resources>