require "shellwords" # String#shellescape — keychain yollarını sh'a güvenle geçir

default_platform(:ios)

# ── Yardımcı: App Store Connect API key'i ENV'den (base64) yükle ─────────────
# GitHub Actions'ta APP_STORE_CONNECT_API_KEY_BASE64 secret'ından geliyor.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"], # p8 içeriği (BEGIN/END PRIVATE KEY dahil)
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  # ─────────────────────────────────────────────────────────────────────────
  # setup_match_certificates
  # ─────────────────────────────────────────────────────────────────────────
  # TEK SEFERLİK. Match private repo boşsa çalıştır — App Store dağıtım
  # sertifikası + provisioning profili üretir, private repo'ya şifreli
  # (MATCH_PASSWORD) push eder. Sonraki build'ler bu artefaktları
  # readonly modda çekip kullanır.
  desc "İlk kurulum: Match ile App Store sertifika + profil üret ve private repo'ya yaz"
  lane :setup_match_certificates do
    api_key = asc_api_key
    match(
      type: "appstore",
      readonly: false,
      force_for_new_devices: false,
      api_key: api_key
    )
    UI.success("Match kurulum tamam — sertifika ve profil #{ENV['MATCH_GIT_URL']} içine yazıldı")
  end

  # ─────────────────────────────────────────────────────────────────────────
  # beta
  # ─────────────────────────────────────────────────────────────────────────
  # Her main push'ta: match readonly ile signing hazırla, Flutter release
  # build al, .ipa üret, TestFlight'a upload et.
  desc "Build ve TestFlight'a upload"
  lane :beta do
    api_key = asc_api_key

    # 0) CI'da izole, kilidi açık bir keychain oluştur.
    #    Bu olmadan match sertifikayı runner'ın `login` keychain'ine yazar ve
    #    codesign keychain'i açmak için ETKİLEŞİMLİ parola istemi gösterir.
    #    Headless runner'da o istem asla yanıtlanmaz: build "Signing ..."
    #    satırında sessizce asılı kalır ve 60 dk job limitinde iptal edilir.
    keychain_path = File.expand_path("~/Library/Keychains/sandik_ci-db")

    if is_ci
      create_keychain(
        name: "sandik_ci",
        password: ENV["MATCH_PASSWORD"],
        default_keychain: true,
        unlock: true,
        timeout: 3600,   # job süresince kilitlenmesin
        lock_when_sleeps: false,
        # Job yeniden çalıştırılırsa keychain zaten var olabilir; hata verme.
        require_create: false
      )

      # `create_keychain` keychain'i DEFAULT yapar ama ARAMA LİSTESİNE
      # eklemez. `security find-identity` ve codesign yalnızca arama
      # listesindeki keychain'lere bakar — bu yüzden match sertifikayı
      # başarıyla kurduğu hâlde bir sonraki satırda "There are no local code
      # signing identities found" yazıyordu; ardından codesign kimliği
      # bulamayıp etkileşimli isteme düşüyor ve 52 dakika asılı kalıyordu
      # (bkz. run 30710359883, "Signing GoogleAppMeasurement..." satırı).
      #
      # login.keychain'i de listede tutuyoruz: Xcode'un kendi yardımcı
      # sertifikaları (Apple WWDR ara sertifikası) orada bulunabiliyor.
      #
      # Mevcut listeyi kabuk yerine Ruby tarafında ayrıştırıyoruz: iç içe
      # tırnak (`tr -d '"'`) kaçışları Fastfile'da kırılgan.
      existing = sh("security list-keychains -d user", log: false)
                   .lines.map { |l| l.strip.delete('"') }.reject(&:empty?)
      search_list = ([keychain_path] + existing).uniq
      sh("security list-keychains -d user -s #{search_list.shelljoin}")

      # Kilidi burada bir kez daha aç: `create_keychain`'in unlock'u
      # arama listesi değişiminden ÖNCE oldu.
      sh("security unlock-keychain -p #{ENV['MATCH_PASSWORD'].to_s.shellescape} " \
         "#{keychain_path.shellescape}")
    end

    # 1) Signing artefaktlarını private cert repo'dan çek (readonly)
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      keychain_name: is_ci ? "sandik_ci" : nil,
      keychain_password: is_ci ? ENV["MATCH_PASSWORD"] : nil
    )

    # 1a) Kimlik gerçekten görünüyor mu? — ERKEN DOĞRULAMA
    #
    # match sertifikayı kurduğunu söylese bile keychain arama listesi yanlışsa
    # `codesign` kimliği bulamaz ve ETKİLEŞİMLİ parola istemine düşer. Headless
    # runner'da o istem yanıtlanmaz: build sessizce asılır ve 60 dk job
    # limitinde iptal edilir (run 30710359883 → 52 dk boş bekleme).
    #
    # Burada 10 saniyede kesin cevabı alırız: kimlik yoksa anlamlı bir hatayla
    # ve hızlıca düşeriz — bir saat beklemek yerine.
    if is_ci
      identities = sh(
        "security find-identity -v -p codesigning #{keychain_path.shellescape} || true",
        log: false
      )
      UI.message("Keychain'deki codesigning kimlikleri:\n#{identities}")

      unless identities.include?("Apple Distribution")
        UI.user_error!(
          "Keychain'de 'Apple Distribution' kimliği yok — codesign etkileşimli " \
          "parola istemine düşer ve job 60 dk'da iptal edilir.\n" \
          "Olası sebepler: MATCH_PASSWORD yanlış, match repo'sundaki sertifika " \
          "süresi dolmuş, ya da keychain arama listesi kurulamadı.\n" \
          "Bulunan kimlikler:\n#{identities}"
        )
      end
    end

    # 1b) Xcode project'i MANUAL signing'e zorla — match'in ürettiği profili
    #     tanısın. Aksi halde Xcode "No profiles for com.sandik.app were
    #     found: Automatic signing is disabled" ile fail eder.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.sandik.app",
      profile_name: "match AppStore com.sandik.app",
      targets: ["Runner"],
      build_configurations: ["Release"]
    )

    # 2) Build number'ı ASC'den al + 1 (Flutter side de bakar ama fastlane
    #    kesin doğruyu alsın; "value already used" hatasına karşı güvenli)
    latest_build = latest_testflight_build_number(
      app_identifier: "com.sandik.app",
      api_key: api_key,
      initial_build_number: 5
    )
    next_build_number = (latest_build || 5) + 1
    UI.message("Bir sonraki build number: #{next_build_number}")

    # 3) Info.plist içindeki CFBundleVersion'ı güncelle
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: next_build_number.to_s
    )

    # 4) Flutter release build (workflow build_ios adımından geliyor;
    #    burada sadece gym ile Xcode archive + export yapılır)
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.sandik.app" => "match AppStore com.sandik.app"
        }
      },
      output_directory: "./build",
      output_name: "sandik.ipa",
      clean: true,
      silent: false,
      suppress_xcode_output: false,
      # OTHER_CODE_SIGN_FLAGS: codesign'a hangi keychain'i kullanacağını
      # açıkça söyler. Bu olmadan arama sırası `login` keychain'e düşebilir
      # ve yeniden parola istemi tetiklenir.
      xcargs: is_ci ? "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_path}'" : nil
    )

    # 5) TestFlight upload
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/sandik.ipa",
      skip_waiting_for_build_processing: true,
      changelog: File.read("../../store_listing/en-US/whats_new.txt").strip
    )

    UI.success("Build #{next_build_number} TestFlight'a upload edildi 🚀")
  end
end
