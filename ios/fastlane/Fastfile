require "shellwords" # String#shellescape — keychain yollarını sh'a güvenle geçir

default_platform(:ios)

# ── Yardımcı: App Store Connect API key'i ENV'den (base64) yükle ─────────────
# GitHub Actions'ta APP_STORE_CONNECT_API_KEY_BASE64 secret'ından geliyor.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"], # p8 içeriği (BEGIN/END PRIVATE KEY dahil)
    is_key_content_base64: false,
    in_house: false
  )
end

# ── Sürüm yardımcıları ───────────────────────────────────────────────────────
#
# Sürüm zinciri:
#   pubspec.yaml `version: X.Y.Z+B`
#     → ios/Flutter/Generated.xcconfig `FLUTTER_BUILD_NAME`
#     → Info.plist `CFBundleShortVersionString` ($(FLUTTER_BUILD_NAME))
#
# Generated.xcconfig gitignore'da ve `flutter build ios` tarafından
# üretiliyor; Xcode archive (gym) ONU okuduğu için fastlane burada
# değiştirdiğinde .ipa yeni sürümle çıkar.

PUBSPEC_PATH = File.expand_path("../../pubspec.yaml", __dir__)
GENERATED_XCCONFIG_PATH = File.expand_path("../Flutter/Generated.xcconfig", __dir__)

# pubspec.yaml'daki sürüm adı (X.Y.Z — "+build" kısmı hariç).
def flutter_version_name
  line = File.readlines(PUBSPEC_PATH).find { |l| l =~ /^version:\s*/ }
  UI.user_error!("pubspec.yaml içinde `version:` bulunamadı") if line.nil?
  line.sub(/^version:\s*/, "").strip.split("+").first
end

# Sürüm adını hem pubspec.yaml'a hem Generated.xcconfig'e yaz.
# Generated.xcconfig kritik olan: gym/archive onu okur.
def set_flutter_version_name(new_version)
  pubspec = File.read(PUBSPEC_PATH)
  pubspec = pubspec.sub(/^version:\s*([^\s+]+)(\+(\d+))?/) do
    build_suffix = Regexp.last_match(3)
    build_suffix ? "version: #{new_version}+#{build_suffix}" : "version: #{new_version}"
  end
  File.write(PUBSPEC_PATH, pubspec)

  if File.exist?(GENERATED_XCCONFIG_PATH)
    cfg = File.read(GENERATED_XCCONFIG_PATH)
    cfg = cfg.sub(/^FLUTTER_BUILD_NAME=.*$/, "FLUTTER_BUILD_NAME=#{new_version}")
    File.write(GENERATED_XCCONFIG_PATH, cfg)
  else
    # `flutter build ios` bu dosyayı üretir; yoksa lane sırası bozulmuş
    # demektir ve sessizce eski sürümle upload etmektense durmak daha iyi.
    UI.user_error!(
      "Generated.xcconfig yok — `flutter build ios` fastlane'den ÖNCE çalışmalı."
    )
  end
end

# Bir sürümün TestFlight'a hâlâ build kabul edip etmediğini sorar.
# ASC'de o sürüm için bir "pre-release train" varsa ve kapalı değilse açıktır.
# Hiç train yoksa (yepyeni sürüm) de açıktır.
def version_open_for_builds?(version, api_key)
  # latest_testflight_build_number belirli bir sürüm için sorgulandığında,
  # sürüm ASC'de yoksa `initial_build_number` döner — bu "yeni sürüm,
  # kullanılabilir" anlamına gelir. Kapalı train'i tespit etmenin güvenilir
  # yolu Spaceship üzerinden sürümün "editable" olup olmadığına bakmaktır.
  require "spaceship"
  # `app_store_connect_api_key` action'ı bir hash döndürür; Spaceship'i
  # o hash ile yetkilendiriyoruz (login yerine token bazlı).
  #
  # `ConnectAPI.auth=` diye bir yazıcı YOK (NoMethodError); bu satır her
  # koşuda patlıyor, rescue "açık varsayılıyor" diyordu, yani kapalı train
  # tespiti hiç çalışmıyordu. Doğrusu `token=`; `Token.from(hash:)` action
  # hash'indeki `is_key_content_base64`'ü de doğru okur.
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find("com.sandik.app")
  return true if app.nil?

  # Bu sürüm için App Store sürüm kaydı var mı ve HÂLÂ build kabul ediyor mu?
  #
  # ## Liste neden TERS ÇEVRİLDİ (2026-09-17)
  # Burada bir "kapalı durumlar" kara listesi vardı ve ASC durum adları
  # değişince SESSİZCE yanlış cevap verdi: 1.1.4 onaylandıktan sonra sürüm
  # `READY_FOR_SALE` değil `READY_FOR_DISTRIBUTION` oldu, liste bunu
  # tanımadı, sürüm "açık" sayıldı ve upload şu hatayla reddedildi:
  #
  #   Invalid Pre-Release Train. The train version '1.1.4' is closed
  #   for new build submissions (90186)
  #   ... must contain a higher version than the previously approved [1.1.4]
  #
  # Kara liste bu iş için YANLIŞ araç: Apple'ın eklediği her yeni durum adı
  # "açık" tarafına düşer ve derleme kırılır. Beyaz liste tersini yapar —
  # tanımadığımız durum "kapalı" sayılır, patch bir artar ve upload geçer.
  # En kötü maliyeti bir sürüm numarası atlamak; alternatifin maliyeti
  # başarısız bir TestFlight derlemesi.
  #
  # Düzenlenebilir (yani hâlâ build kabul eden) durumlar:
  editable_states = %w[
    PREPARE_FOR_SUBMISSION
    DEVELOPER_REJECTED
    REJECTED
    METADATA_REJECTED
    INVALID_BINARY
    WAITING_FOR_EXPORT_COMPLIANCE
  ]
  versions = app.get_app_store_versions(
    filter: { versionString: version },
    includes: "appStoreVersionSubmission"
  )
  return true if versions.nil? || versions.empty?

  durumlar = versions.map(&:app_store_state)
  acik = durumlar.all? { |d| editable_states.include?(d) }
  UI.message("ASC sürüm #{version} durumu: #{durumlar.join(', ')} → " \
             "#{acik ? 'açık' : 'KAPALI (patch artacak)'}")
  acik
rescue StandardError => e
  # ASC sorgusu başarısız olursa sürümü "açık" kabul et: yanlışlıkla
  # sürüm atlamaktansa upload'ın kendi hatasını vermesi daha iyi.
  UI.important("Sürüm durumu sorgulanamadı (#{e.class}: #{e.message}) — açık varsayılıyor.")
  true
end

# Açık bir sürüm bulana kadar patch'i artır. Sonsuz döngüye karşı sınırlı.
def next_open_version(version, api_key)
  candidate = version
  10.times do
    return candidate if version_open_for_builds?(candidate, api_key)
    parts = candidate.split(".").map(&:to_i)
    parts << 0 while parts.length < 3
    parts[2] += 1
    candidate = parts.join(".")
  end
  UI.user_error!(
    "#{version}'dan itibaren 10 patch denendi, TestFlight'a açık sürüm bulunamadı."
  )
end

# ── TestFlight "What to Test" metni ──────────────────────────────────────────
#
# **Her build'de FARKLI olmalı.**
#
# `whats_new.txt` sürümler arası nadiren değişir ve build numarası ASC'den
# gelen timestamp benzeri bir sayıdır. Sonuç: TestFlight listesinde iki ardışık
# build birebir aynı görünüyordu — aynı sürüm (1.1.4), aynı sürüm notu, tek
# fark build numarasının SON HANESİ (ölçüldü: 1785274296 → 1785274297).
# Kullanıcı yeni build'in gelip gelmediğini ayırt edemiyordu.
#
# Çözüm: sürüm notlarının altına o build'in KİMLİĞİ eklenir — build numarası,
# commit'in kısa SHA'sı ve commit başlığı. Böylece TestFlight'ta her satır
# hangi değişikliği taşıdığını kendisi söyler.
#
# `whats_new.txt` DOSYASI DEĞİŞMEZ: kimlik satırı yalnızca upload sırasında,
# bellekte eklenir. O dosya mağaza sürüm notudur; build kimliği oraya girerse
# App Store'a sızar.
CHANGELOG_LIMIT = 4000 # App Store Connect "What to Test" üst sınırı

def testflight_changelog(build_number)
  # `encoding: "UTF-8"` ŞART: dosya "•" madde imleriyle başlıyor ve runner'ın
  # locale'i UTF-8 değilse `File.read` içeriği US-ASCII etiketler — `strip`
  # bile "invalid byte sequence" ile patlar (bu container'da birebir üretildi).
  # Eski kod bunu taşıyordu; GitHub macOS runner'ının UTF-8 locale'i gizliyordu.
  notes = File.read("../../store_listing/en-US/whats_new.txt", encoding: "UTF-8")
              .scrub("").strip

  kimlik = begin
    # `force_encoding` + `scrub`: runner'ın locale'i UTF-8 değilse backtick
    # çıktısı US-ASCII etiketli gelir. Türkçe başlıklı bir commit'te bu, UTF-8
    # literal ile birleştirilirken Encoding::CompatibilityError fırlatır ve
    # başlık sessizce kaybolurdu (rescue yakalar ama kimlik satırı yarım kalır).
    sha = sh("git rev-parse --short HEAD", log: false)
            .to_s.force_encoding("UTF-8").scrub("").strip
    subject = sh("git log -1 --pretty=%s", log: false)
                .to_s.force_encoding("UTF-8").scrub("").strip
    # Tek satır ve makul uzunlukta tut — TestFlight bu alanı dar gösterir.
    subject = "#{subject[0, 157]}..." if subject.length > 160
    ["Build #{build_number} · #{sha}", subject].reject(&:empty?).join("\n")
  rescue StandardError => e
    # Git okunamazsa (sığ klon, repo dışı çalıştırma) build numarası tek
    # başına yine ayırt edicidir — upload'ı bunun için düşürmeyiz.
    UI.important("Commit bilgisi okunamadı (#{e.class}) — yalnızca build no yazılıyor.")
    "Build #{build_number}"
  end

  full = "#{notes}\n\n———\n#{kimlik}"
  full.length > CHANGELOG_LIMIT ? full[0, CHANGELOG_LIMIT] : full
end

HARICI_VARSAYILAN_NOT = "Yeni build. Lütfen portföy ekleme, Özet ve bildirimleri dene; " \
                        "sorunları TestFlight üzerinden ekran görüntüsüyle bildir."

# ASC'nin build'i işlemesini bekler (VALID olana dek). `asc_api_key`
# çağrıldıktan sonra Spaceship oturumu açıktır.
def islenmeyi_bekle(build_number, sure_dk: 45)
  app = Spaceship::ConnectAPI::App.find("com.sandik.app")
  UI.user_error!("ASC'de com.sandik.app bulunamadı") if app.nil?

  bitis = Time.now + (sure_dk * 60)
  loop do
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, build_number: build_number.to_s, limit: 1
    ).first
    durum = build&.processing_state
    if durum == "VALID"
      UI.success("Build #{build_number} işlendi.")
      return
    end
    UI.user_error!("Build #{build_number} işlenemedi: #{durum}") if %w[FAILED INVALID].include?(durum)
    UI.user_error!("Build #{build_number} #{sure_dk} dk içinde işlenmedi (durum: #{durum || 'yok'})") if Time.now > bitis

    UI.message("Build #{build_number} durumu: #{durum || 'henüz görünmüyor'} — 60 sn sonra yeniden bakılacak")
    sleep 60
  end
end

platform :ios do
  # ─────────────────────────────────────────────────────────────────────────
  # setup_match_certificates
  # ─────────────────────────────────────────────────────────────────────────
  # TEK SEFERLİK. Match private repo boşsa çalıştır — App Store dağıtım
  # sertifikası + provisioning profili üretir, private repo'ya şifreli
  # (MATCH_PASSWORD) push eder. Sonraki build'ler bu artefaktları
  # readonly modda çekip kullanır.
  desc "İlk kurulum: Match ile App Store sertifika + profil üret ve private repo'ya yaz"
  lane :setup_match_certificates do
    api_key = asc_api_key
    match(
      type: "appstore",
      readonly: false,
      force_for_new_devices: false,
      api_key: api_key
    )
    UI.success("Match kurulum tamam — sertifika ve profil #{ENV['MATCH_GIT_URL']} içine yazıldı")
  end

  # ─────────────────────────────────────────────────────────────────────────
  # match_parola_degistir
  # ─────────────────────────────────────────────────────────────────────────
  # MATCH_PASSWORD 2026-10-01'de herkese açık Actions günlüğüne basıldı (#46).
  # `fastlane match change_password` yeni parolayı ETKİLEŞİMLİ sorar, CI'da
  # koşmaz; geliştirici makinesinde de Ruby yok. Bu lane aynı adımları
  # (match/lib/match/change_password.rb) parolaları ortamdan alarak yapar:
  # eski = MATCH_PASSWORD, yeni = MATCH_PASSWORD_YENI.
  #
  # İki doğrulama: depoya yazmadan ÖNCE yeni parolayla geri çözülebiliyor mu
  # (kopyada), yazdıktan SONRA depo baştan indirilip yeni parolayla çözülüyor
  # mu. Yazma başarılıysa GitHub'daki MATCH_PASSWORD hemen yeni değere
  # güncellenmeli — o ana kadar iOS derlemeleri sertifikayı çözemez.
  desc "Match sertifika deposunun parolasını değiştir (CI, etkileşimsiz)"
  lane :match_parola_degistir do
    require "match"
    require "tmpdir"

    eski = ENV["MATCH_PASSWORD"].to_s
    yeni = ENV["MATCH_PASSWORD_YENI"].to_s
    UI.user_error!("MATCH_PASSWORD (eski parola) eksik") if eski.empty?
    UI.user_error!("MATCH_PASSWORD_YENI secret'ı eksik") if yeni.empty?
    UI.user_error!("Yeni parola eskisiyle aynı") if yeni == eski
    # Yalnız harf/rakam: eski parolada kabuk kaçışı (`\#`, `\&`) değeri
    # değiştirdi ve GitHub maskesi tutmadı (#46).
    unless yeni.match?(/\A[A-Za-z0-9]{32,}\z/)
      UI.user_error!("Yeni parola en az 32 karakter ve yalnız harf/rakam olmalı (openssl rand -hex 32)")
    end

    params = FastlaneCore::Configuration.create(Match::Options.available_options, {
      storage_mode: "git",
      type: "appstore",
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      # Runner'da git kimliği yok; commit için şart.
      git_full_name: "sandik-ci",
      git_user_email: "41898282+github-actions[bot]@users.noreply.github.com",
      readonly: false
    })
    sifreleme = lambda do |dizin|
      Match::Encryption.for_storage_mode("git", {
        git_url: params[:git_url],
        s3_bucket: nil,
        s3_skip_encryption: false,
        working_directory: dizin,
        force_legacy_encryption: false
      })
    end
    # decrypt_files parolayı yalnız ENV'den okur.
    parolayla = lambda do |parola, &blok|
      onceki = ENV["MATCH_PASSWORD"]
      begin
        ENV["MATCH_PASSWORD"] = parola
        blok.call
      ensure
        ENV["MATCH_PASSWORD"] = onceki
      end
    end

    dosyalar = []
    storage = Match::Storage.from_params(params)
    begin
      storage.download
      enc = sifreleme.call(storage.working_directory)
      parolayla.call(eski) { enc.decrypt_files }
      dosyalar = enc.encrypt_files(password: yeni)
      UI.user_error!("Depoda şifreli dosya yok — yanlış depo?") if dosyalar.empty?

      Dir.mktmpdir do |kopya|
        FileUtils.cp_r(File.join(storage.working_directory, "."), kopya)
        parolayla.call(yeni) { sifreleme.call(kopya).decrypt_files }
      end

      storage.save_changes!(files_to_commit: dosyalar,
                            custom_message: "[fastlane] Changed passphrase (CI)")
    ensure
      storage.clear_changes
    end

    kontrol = Match::Storage.from_params(params)
    begin
      kontrol.download
      parolayla.call(yeni) { sifreleme.call(kontrol.working_directory).decrypt_files }
    ensure
      kontrol.clear_changes
    end
    UI.success("Parola değişti ve doğrulandı (#{dosyalar.count} dosya). " \
               "ŞİMDİ GitHub secret MATCH_PASSWORD'ü MATCH_PASSWORD_YENI ile aynı yap.")
  end

  # ─────────────────────────────────────────────────────────────────────────
  # beta
  # ─────────────────────────────────────────────────────────────────────────
  # Her main push'ta: match readonly ile signing hazırla, Flutter release
  # build al, .ipa üret, TestFlight'a upload et.
  desc "Build ve TestFlight'a upload"
  lane :beta do
    api_key = asc_api_key

    # 0) CI'da izole, kilidi açık bir keychain oluştur.
    #    Bu olmadan match sertifikayı runner'ın `login` keychain'ine yazar ve
    #    codesign keychain'i açmak için ETKİLEŞİMLİ parola istemi gösterir.
    #    Headless runner'da o istem asla yanıtlanmaz: build "Signing ..."
    #    satırında sessizce asılı kalır ve 60 dk job limitinde iptal edilir.
    keychain_path = File.expand_path("~/Library/Keychains/sandik_ci-db")

    if is_ci
      create_keychain(
        name: "sandik_ci",
        password: ENV["MATCH_PASSWORD"],
        default_keychain: true,
        unlock: true,
        timeout: 3600,   # job süresince kilitlenmesin
        lock_when_sleeps: false,
        # Job yeniden çalıştırılırsa keychain zaten var olabilir; hata verme.
        require_create: false
      )

      # `create_keychain` keychain'i DEFAULT yapar ama ARAMA LİSTESİNE
      # eklemez. `security find-identity` ve codesign yalnızca arama
      # listesindeki keychain'lere bakar — bu yüzden match sertifikayı
      # başarıyla kurduğu hâlde bir sonraki satırda "There are no local code
      # signing identities found" yazıyordu; ardından codesign kimliği
      # bulamayıp etkileşimli isteme düşüyor ve 52 dakika asılı kalıyordu
      # (bkz. run 30710359883, "Signing GoogleAppMeasurement..." satırı).
      #
      # login.keychain'i de listede tutuyoruz: Xcode'un kendi yardımcı
      # sertifikaları (Apple WWDR ara sertifikası) orada bulunabiliyor.
      #
      # Mevcut listeyi kabuk yerine Ruby tarafında ayrıştırıyoruz: iç içe
      # tırnak (`tr -d '"'`) kaçışları Fastfile'da kırılgan.
      existing = sh("security list-keychains -d user", log: false)
                   .lines.map { |l| l.strip.delete('"') }.reject(&:empty?)
      search_list = ([keychain_path] + existing).uniq
      sh("security list-keychains -d user -s #{search_list.shelljoin}")

      # Kilidi burada bir kez daha aç: `create_keychain`'in unlock'u
      # arama listesi değişiminden ÖNCE oldu.
      #
      # `log: false` ŞART: fastlane komutu hem satır olarak hem sonda "fastlane
      # summary" tablosunda basar; repo herkese açık olduğundan Actions
      # günlüğündeki MATCH_PASSWORD herkese açıktı (GitHub maskelemedi: kabuk
      # kaçışı `\#`, `\&` gibi ters bölü ekleyince düz değer artık secret'la
      # eşleşmiyor). 2026-10-01'de run 36858248547'de görüldü.
      sh("security unlock-keychain -p #{ENV['MATCH_PASSWORD'].to_s.shellescape} " \
         "#{keychain_path.shellescape}", log: false)
    end

    # 1) Signing artefaktlarını private cert repo'dan çek (readonly)
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      keychain_name: is_ci ? "sandik_ci" : nil,
      keychain_password: is_ci ? ENV["MATCH_PASSWORD"] : nil
    )

    # 1a) Kimlik gerçekten görünüyor mu? — ERKEN DOĞRULAMA
    #
    # match sertifikayı kurduğunu söylese bile keychain arama listesi yanlışsa
    # `codesign` kimliği bulamaz ve ETKİLEŞİMLİ parola istemine düşer. Headless
    # runner'da o istem yanıtlanmaz: build sessizce asılır ve 60 dk job
    # limitinde iptal edilir (run 30710359883 → 52 dk boş bekleme).
    #
    # Burada 10 saniyede kesin cevabı alırız: kimlik yoksa anlamlı bir hatayla
    # ve hızlıca düşeriz — bir saat beklemek yerine.
    if is_ci
      identities = sh(
        "security find-identity -v -p codesigning #{keychain_path.shellescape} || true",
        log: false
      )
      UI.message("Keychain'deki codesigning kimlikleri:\n#{identities}")

      unless identities.include?("Apple Distribution")
        UI.user_error!(
          "Keychain'de 'Apple Distribution' kimliği yok — codesign etkileşimli " \
          "parola istemine düşer ve job 60 dk'da iptal edilir.\n" \
          "Olası sebepler: MATCH_PASSWORD yanlış, match repo'sundaki sertifika " \
          "süresi dolmuş, ya da keychain arama listesi kurulamadı.\n" \
          "Bulunan kimlikler:\n#{identities}"
        )
      end
    end

    # 1b) Xcode project'i MANUAL signing'e zorla — match'in ürettiği profili
    #     tanısın. Aksi halde Xcode "No profiles for com.sandik.app were
    #     found: Automatic signing is disabled" ile fail eder.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.sandik.app",
      profile_name: "match AppStore com.sandik.app",
      targets: ["Runner"],
      build_configurations: ["Release"]
    )

    # 1c) Live Activity uzantısı AYRI hedef, AYRI bundle id, AYRI profil.
    #
    #     Ana uygulamanın profili uzantıyı kapsamaz; ayrı bir çağrı şart.
    #     Atlanırsa archive adımı uzantıyı imzalayamaz ve
    #     "No profiles for com.sandik.app.SandikWidget were found" ile kırılır.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.sandik.app.SandikWidget",
      profile_name: "match AppStore com.sandik.app.SandikWidget",
      targets: ["SandikWidgetExtension"],
      build_configurations: ["Release"]
    )

    # 2a) Sürüm (marketing version) hâlâ build kabul ediyor mu?
    #
    #     App Store Connect bir sürümü gönderildikten/yayınlandıktan sonra
    #     "train"ini KAPATIR. Kapalı train'e upload şu hatayla reddedilir:
    #
    #       Invalid Pre-Release Train. The train version 'X' is closed
    #       for new build submissions (90186)
    #
    #     Build number artışı bunu ÇÖZMEZ — kapalı olan sürümün kendisidir.
    #     Bu yüzden upload'tan önce sürümü kontrol edip gerekirse patch'i
    #     yükseltiyoruz. Böylece "TestFlight'a at" her seferinde çalışır.
    current_version = flutter_version_name
    target_version = next_open_version(current_version, api_key)

    if target_version != current_version
      UI.important(
        "Sürüm #{current_version} TestFlight'a kapalı — #{target_version} kullanılacak."
      )
      set_flutter_version_name(target_version)
    else
      UI.message("Sürüm #{current_version} açık, olduğu gibi kullanılıyor.")
    end

    # 2b) Build number'ı ASC'den al + 1 (Flutter side de bakar ama fastlane
    #    kesin doğruyu alsın; "value already used" hatasına karşı güvenli)
    #
    #    DİKKAT: build number SÜRÜME ÖZELDİR. `version` parametresi
    #    verilmezse fastlane "en son train"e bakar; yeni bir sürüme
    #    geçtiğimizde bu alakasız bir sayı döndürebilir. Hedef sürümü
    #    açıkça geçiyoruz.
    #    ASC build number'ı UYGULAMA GENELİNDE artan olmalı — sadece sürüm
    #    içinde değil. Bu yüzden iki değerin BÜYÜĞÜNÜ alıyoruz:
    #      • hedef sürümün en yüksek build'i
    #      • herhangi bir sürümdeki en yüksek build
    #    (Geçmişte "any version" sorgusu 1785274244 gibi timestamp bir değer
    #    döndürdü; yeni sürüme 1'den başlarsak ASC "daha düşük" diye reddeder.)
    build_in_version = latest_testflight_build_number(
      app_identifier: "com.sandik.app",
      api_key: api_key,
      version: target_version,
      initial_build_number: 0
    ) || 0

    build_any_version = latest_testflight_build_number(
      app_identifier: "com.sandik.app",
      api_key: api_key,
      initial_build_number: 0
    ) || 0

    next_build_number = [build_in_version, build_any_version].max + 1
    UI.message(
      "Build number → sürüm içi: #{build_in_version}, genel: #{build_any_version} " \
      "⇒ #{next_build_number}"
    )

    # 3) Info.plist içindeki CFBundleVersion'ı güncelle
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: next_build_number.to_s
    )

    # 4) Flutter release build (workflow build_ios adımından geliyor;
    #    burada sadece gym ile Xcode archive + export yapılır)
    # Derleme TEK TANIM: aşağıdaki "kapalı train" yeniden denemesi de bunu
    # çağırır. İki ayrı `build_app` çağrısı tutmak bu projede tekrar eden
    # hata sınıfı — ilk kopyada duran `configuration`, `clean` ve keychain
    # bayrağı ikincisinde eksik kalır ve yeniden deneme imzasız/yanlış
    # yapılandırmada derlerdi.
    derle = lambda do
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            "com.sandik.app" => "match AppStore com.sandik.app",
            # Uzantı da export haritasında olmalı; eksikse `gym` .ipa'yı
            # paketlerken uzantı için profil bulamaz.
            "com.sandik.app.SandikWidget" =>
              "match AppStore com.sandik.app.SandikWidget"
          }
        },
        output_directory: "./build",
        output_name: "sandik.ipa",
        clean: true,
        silent: false,
        suppress_xcode_output: false,
        # OTHER_CODE_SIGN_FLAGS: codesign'a hangi keychain'i kullanacağını
        # açıkça söyler. Bu olmadan arama sırası `login` keychain'e düşebilir
        # ve yeniden parola istemi tetiklenir.
        xcargs: is_ci ? "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_path}'" : nil
      )
    end

    derle.call

    # 5) dSYM'leri Crashlytics'e yükle — SEMBOLİZASYON İÇİN ŞART.
    #
    #    Xcode Release yapılandırması dSYM ÜRETİYOR (`DEBUG_INFORMATION_FORMAT
    #    = dwarf-with-dsym`, pbxproj) ama üretmek yetmez: Crashlytics onları
    #    ayrıca almalı. Bu adım yokken her iOS build'i Firebase'de
    #    "Missing dSYM (required)" uyarısı bırakıyordu ve crash'lerin stack
    #    trace'i HAM ADRES olarak kalıyordu — yani üretimde çöken kodun hangi
    #    satır olduğu OKUNAMIYORDU (12 build, 1.1.4'ün tamamı).
    #
    #    Neden TestFlight upload'undan ÖNCE: upload_to_testflight uzun sürer
    #    ve `skip_waiting_for_build_processing: true` ile bile ağ hatasında
    #    düşebilir. Sembol yükleme ucuz; crash görünürlüğünü dağıtımın
    #    başarısına bağlamıyoruz.
    #
    #    `dsym_path` lane context'ten gelir — `build_app` arşivden çıkardığı
    #    .dSYM.zip'in yolunu oraya yazar. Sabit yol YAZMIYORUZ: gym'in çıktı
    #    adı output_name/şemaya göre değişir ve elle yazılan yol sessizce
    #    ıskalar (ıskalanırsa bu adım hata vermeden hiçbir şey yüklemez).
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]

    # `upload-symbols` binary'sini BUL — sabit yol yazma.
    #
    # ⚠️ Bu proje CocoaPods DEĞİL, Swift Package Manager kullanıyor
    # (`ios/Podfile.lock` yok; Flutter'ın SPM entegrasyonu). Yani
    # `Pods/FirebaseCrashlytics/upload-symbols` HİÇ OLUŞMUYOR — ilk
    # denemede oraya bakılmış ve build sembolsüz gitmişti
    # (run 34978673552: "upload-symbols ... var mı: false").
    #
    # SPM checkout'ları DerivedData altında ve yol her koşuda değişiyor,
    # bu yüzden aranıyor. `find` çıktısının ilki alınır: aynı binary'nin
    # birden çok kopyası olabilir, hepsi aynı işi yapar.
    upload_symbols_binary = begin
      derived = File.expand_path("~/Library/Developer/Xcode/DerivedData")
      hits = Dir.glob(
        "#{derived}/**/SourcePackages/checkouts/firebase-ios-sdk/" \
        "Crashlytics/upload-symbols"
      )
      # Yedek: SPM düzeni değişirse adıyla geniş ara (DerivedData büyük
      # olduğundan yalnızca ilk arama boş dönünce çalışır).
      hits = Dir.glob("#{derived}/**/upload-symbols") if hits.empty?
      hits.find { |p| File.file?(p) && File.executable?(p) }
    end

    if dsym_path && File.exist?(dsym_path) && upload_symbols_binary
      upload_symbols_to_crashlytics(
        dsym_path: dsym_path,
        binary_path: upload_symbols_binary,
        # Plist, uygulamanın Firebase app id'sini taşır; workflow bunu
        # secret'tan decode ediyor. Yolu açıkça veriyoruz çünkü fastlane
        # çalışma dizini ios/fastlane, plist ise ios/Runner altında.
        gsp_path: File.expand_path("../Runner/GoogleService-Info.plist", __dir__)
      )
      UI.success("dSYM Crashlytics'e yüklendi: #{dsym_path}")
    else
      # Sessiz geçmiyoruz: sembolsüz bir build, çöktüğünde teşhis edilemez.
      # Dağıtımı bunun için DURDURMUYORUZ (build zaten imzalı ve geçerli),
      # ama log'da aranabilir bir uyarı bırakıyoruz.
      UI.important(
        "dSYM Crashlytics'e YÜKLENMEDİ — bu build sembolsüz kalacak.\n" \
        "  dSYM yolu:        #{dsym_path.inspect} " \
        "(var mı: #{dsym_path ? File.exist?(dsym_path) : false})\n" \
        "  upload-symbols:   #{upload_symbols_binary.inspect} (arama sonucu)"
      )
    end

    # 6) TestFlight upload
    #
    # ## Kapalı train'e karşı SON SAVUNMA (2026-09-17)
    # Yukarıdaki ASC sorgusu sürümün açık olduğunu söylese bile upload
    # reddedilebiliyor (durum adları değişir, sorgu düşer, yarış olur).
    # O noktada elde imzalı bir IPA var ama sürüm numarası yanlış: tek
    # çözüm sürümü artırıp YENİDEN derlemek.
    #
    # Sessizce kırılmak yerine bir kez bunu deniyoruz — "TestFlight'a at"
    # komutunun elle müdahale istemesi, bu projede tekrar eden bir zaman
    # kaybıydı. İkinci denemede de reddedilirse hata olduğu gibi yükselir.
    kapali_train = lambda do |e|
      m = e.message.to_s
      m.include?("90186") || m.include?("90062") ||
        m.include?("closed for new build submissions") ||
        m.include?("must contain a higher version")
    end

    begin
      upload_to_testflight(
        api_key: api_key,
        ipa: "./build/sandik.ipa",
        skip_waiting_for_build_processing: true,
        changelog: testflight_changelog(next_build_number)
      )
    rescue StandardError => e
      raise unless kapali_train.call(e)

      yeni_surum = next_open_version(
        flutter_version_name.split(".").tap { |p| p[2] = (p[2].to_i + 1).to_s }.join("."),
        api_key
      )
      UI.important(
        "Upload kapalı train yüzünden reddedildi. Sürüm #{yeni_surum} ile " \
        "YENİDEN derleniyor (tek deneme)."
      )
      set_flutter_version_name(yeni_surum)
      derle.call
      upload_to_testflight(
        api_key: api_key,
        ipa: "./build/sandik.ipa",
        skip_waiting_for_build_processing: true,
        changelog: testflight_changelog(next_build_number)
      )
    end

    UI.success("Build #{next_build_number} TestFlight'a upload edildi 🚀")

    # Sonraki workflow adımı (harici gruba gönderim) aynı build'i hedeflesin
    # diye numarayı GITHUB_ENV'e yaz. Build numarası uygulama genelinde tekil
    # (yukarıdaki 2b), sürüm adı gerekmez.
    if ENV["GITHUB_ENV"]
      File.write(ENV["GITHUB_ENV"], "TF_BUILD_NUMBER=#{next_build_number}\n", mode: "a")
    end
  end

  # ─────────────────────────────────────────────────────────────────────────
  # harici_dagit
  # ─────────────────────────────────────────────────────────────────────────
  # TestFlight'ta ZATEN işlenmiş bir build'i harici (external) test grubuna
  # gönderir. Derleme/imzalama yok, match gerekmez — yalnızca ASC API key.
  #
  # Neden `beta`dan ayrı lane: `beta` `skip_waiting_for_build_processing:
  # true` ile işlemeyi beklemeden çıkar; harici dağıtım işlenmiş build ister
  # (`bekle:true` bekler). İki çağıran: ios-testflight.yml her main
  # birleşmesinde (TESTFLIGHT_HARICI_GRUP doluysa — yasin kararı 2026-10-01,
  # Android kapalı testle aynı anda) ve testflight-external.yml elle (eski
  # bir build'i yeniden göndermek için).
  #
  # İlk harici gönderim Apple'ın Beta App Review'una düşer (genelde < 1 gün);
  # sonraki build'ler çoğunlukla otomatik onaylanır. ASC → TestFlight → Test
  # Information (geri bildirim e-postası, iletişim, giriş bilgisi) dolu
  # değilse Apple gönderimi reddeder — o durumda hata mesajı bunu söyler.
  desc "İşlenmiş son (veya verilen) build'i harici TestFlight grubuna gönder"
  lane :harici_dagit do |options|
    gruplar = options[:groups].to_s.split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("En az bir harici grup adı ver (groups:)") if gruplar.empty?

    notlar = options[:changelog].to_s.strip
    # Otomatik zincirde metin repo değişkeninden gelir; boşsa varsayılan.
    # whats_new.txt kullanılmaz: İngilizce mağaza notu, harici testçi Türkçe.
    notlar = HARICI_VARSAYILAN_NOT if notlar.empty?
    notlar = notlar[0, CHANGELOG_LIMIT] if notlar.length > CHANGELOG_LIMIT

    api_key = asc_api_key
    params = {
      api_key: api_key,
      distribute_only: true,
      # distribute_only'de IPA yok; pilot platformu çıkaramayınca SORAR ve
      # CI'da "non-interactive mode" ile düşer (2026-10-01, koşu 36902929795).
      app_platform: "ios",
      distribute_external: true,
      notify_external_testers: true,
      groups: gruplar,
      # Info.plist ITSAppUsesNonExemptEncryption=false ile aynı beyan;
      # verilmezse pilot soru sorup CI'da takılabilir.
      uses_non_exempt_encryption: false
    }
    # Boş bırakılırsa pilot en son yüklenen build'i seçer.
    params[:build_number] = options[:build_number].to_s if options[:build_number].to_s.strip != ""
    params[:app_version] = options[:app_version].to_s if options[:app_version].to_s.strip != ""
    params[:changelog] = notlar unless notlar.empty?

    # Otomatik zincirde (ios-testflight.yml) build daha işleniyor olur;
    # pilot'un distribute_only yolu beklemez, işlenmemiş build'i reddeder.
    islenmeyi_bekle(params[:build_number]) if options[:bekle].to_s == "true" && params[:build_number]

    upload_to_testflight(**params)
    UI.success("Harici gruba gönderildi: #{gruplar.join(', ')} 🚀")
  end
end
