<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>Sandık</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!--
	  Sürüm alanları ana uygulamayla BİREBİR aynı olmalı; aksi halde
	  App Store Connect yüklemeyi "bundle version mismatch" ile reddeder.
	  fastlane bump'ı Runner'a uyguladığı için burada da aynı değişkenler
	  kullanılır (bkz. ios/fastlane/Fastfile).
	-->
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
	  DM Sans — uygulamanın marka fontu.

	  Uzantı ana uygulamanın font kaydını MİRAS ALMAZ: her hedef kendi
	  `UIAppFonts` listesini taşımak zorundadır. Bu liste olmadan
	  `Font.custom("DMSans-...")` sessizce sistem fontuna düşer ve kilit
	  ekranı uygulamadan farklı görünür.

	  Dosyalar `ios/SandikWidget/Fonts/` altındadır ve SandikWidget
	  hedefinin "Copy Bundle Resources" fazına eklenmelidir.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-SemiBold.ttf</string>
		<string>DMSans-Bold.ttf</string>
		<string>DMSans-Black.ttf</string>
	</array>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
