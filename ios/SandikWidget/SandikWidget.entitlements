<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Ana uygulamanınkiyle BİREBİR aynı olmalı — tek harf farkı uzantıyı
	  sessizce boş veriye düşürür (çalışır ama hep "veri yok" gösterir).
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sandik.app</string>
	</array>
</dict>
</plist>
